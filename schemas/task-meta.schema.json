{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgyTaskMetaV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "deny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["allow", "deny"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "require_clean_git": {
          "type": "boolean"
        }
      },
      "required": ["commands", "require_clean_git"]
    }
  },
  "required": ["contract_version", "task_id", "task_class", "scope", "verification"]
}
