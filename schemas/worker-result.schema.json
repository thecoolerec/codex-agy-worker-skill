{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgyWorkerResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "BLOCKED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "result",
          "details"
        ]
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_decision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "summary",
    "files_changed",
    "commands_run",
    "tests",
    "deviations",
    "blocker_type",
    "observed_state",
    "requested_decision"
  ]
}
